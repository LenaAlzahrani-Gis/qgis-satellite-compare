<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SatCompareDialogBase</class>
 <widget class="QDialog" name="SatCompareDialogBase">
  <property name="geometry"><rect><x>0</x><y>0</y><width>500</width><height>680</height></rect></property>
  <property name="windowTitle"><string>Satellite Compare</string></property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item><widget class="QLabel" name="lblTitle"><property name="text"><string>&lt;b&gt;Satellite Compare&lt;/b&gt; — compare NDVI / LST between two years</string></property></widget></item>
   <item>
    <widget class="QGroupBox" name="grpInput">
     <property name="title"><string>1. Input type</string></property>
     <layout class="QHBoxLayout" name="layoutInput">
      <item><widget class="QRadioButton" name="radioReady"><property name="text"><string>Ready index rasters</string></property><property name="checked"><bool>true</bool></property></widget></item>
      <item><widget class="QRadioButton" name="radioRaw"><property name="text"><string>Raw Landsat 8/9 L2 bands</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="grpIndex">
     <property name="title"><string>2. Index</string></property>
     <layout class="QHBoxLayout" name="layoutIndex">
      <item><widget class="QRadioButton" name="radioNdvi"><property name="text"><string>NDVI (vegetation)</string></property><property name="checked"><bool>true</bool></property></widget></item>
      <item><widget class="QRadioButton" name="radioLst"><property name="text"><string>LST (temperature °C)</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="grpYear1">
     <property name="title"><string>3. First year</string></property>
     <layout class="QFormLayout" name="formYear1">
      <item row="0" column="0"><widget class="QLabel" name="lblYear1"><property name="text"><string>Year</string></property></widget></item>
      <item row="0" column="1"><widget class="QSpinBox" name="spinYear1"><property name="minimum"><number>1984</number></property><property name="maximum"><number>2100</number></property><property name="value"><number>2015</number></property></widget></item>
      <item row="1" column="0"><widget class="QLabel" name="lblReady1"><property name="text"><string>Index raster</string></property></widget></item>
      <item row="1" column="1"><widget class="QgsMapLayerComboBox" name="cmbReady1"/></item>
      <item row="2" column="0"><widget class="QLabel" name="lblRed1"><property name="text"><string>Red (SR_B4)</string></property></widget></item>
      <item row="2" column="1"><widget class="QgsMapLayerComboBox" name="cmbRed1"/></item>
      <item row="3" column="0"><widget class="QLabel" name="lblNir1"><property name="text"><string>NIR (SR_B5)</string></property></widget></item>
      <item row="3" column="1"><widget class="QgsMapLayerComboBox" name="cmbNir1"/></item>
      <item row="4" column="0"><widget class="QLabel" name="lblThermal1"><property name="text"><string>Thermal (ST_B10)</string></property></widget></item>
      <item row="4" column="1"><widget class="QgsMapLayerComboBox" name="cmbThermal1"/></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="grpYear2">
     <property name="title"><string>4. Second year</string></property>
     <layout class="QFormLayout" name="formYear2">
      <item row="0" column="0"><widget class="QLabel" name="lblYear2"><property name="text"><string>Year</string></property></widget></item>
      <item row="0" column="1"><widget class="QSpinBox" name="spinYear2"><property name="minimum"><number>1984</number></property><property name="maximum"><number>2100</number></property><property name="value"><number>2025</number></property></widget></item>
      <item row="1" column="0"><widget class="QLabel" name="lblReady2"><property name="text"><string>Index raster</string></property></widget></item>
      <item row="1" column="1"><widget class="QgsMapLayerComboBox" name="cmbReady2"/></item>
      <item row="2" column="0"><widget class="QLabel" name="lblRed2"><property name="text"><string>Red (SR_B4)</string></property></widget></item>
      <item row="2" column="1"><widget class="QgsMapLayerComboBox" name="cmbRed2"/></item>
      <item row="3" column="0"><widget class="QLabel" name="lblNir2"><property name="text"><string>NIR (SR_B5)</string></property></widget></item>
      <item row="3" column="1"><widget class="QgsMapLayerComboBox" name="cmbNir2"/></item>
      <item row="4" column="0"><widget class="QLabel" name="lblThermal2"><property name="text"><string>Thermal (ST_B10)</string></property></widget></item>
      <item row="4" column="1"><widget class="QgsMapLayerComboBox" name="cmbThermal2"/></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="grpOptions">
     <property name="title"><string>5. Options</string></property>
     <layout class="QFormLayout" name="formOptions">
      <item row="0" column="0"><widget class="QLabel" name="lblThreshold"><property name="text"><string>Change threshold</string></property></widget></item>
      <item row="0" column="1"><widget class="QDoubleSpinBox" name="spinThreshold"><property name="decimals"><number>2</number></property><property name="maximum"><double>50.0</double></property><property name="singleStep"><double>0.05</double></property><property name="value"><double>0.10</double></property></widget></item>
      <item row="1" column="0"><widget class="QLabel" name="lblOutput"><property name="text"><string>Output folder</string></property></widget></item>
      <item row="1" column="1"><widget class="QgsFileWidget" name="fileOutput"><property name="storageMode"><enum>QgsFileWidget::GetDirectory</enum></property></widget></item>
     </layout>
    </widget>
   </item>
   <item><widget class="QLabel" name="lblCredit"><property name="text"><string>Developed by Lena Alzahrani</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
   <item><widget class="QDialogButtonBox" name="button_box"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set></property></widget></item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget><class>QgsMapLayerComboBox</class><extends>QComboBox</extends><header>qgsmaplayercombobox.h</header></customwidget>
  <customwidget><class>QgsFileWidget</class><extends>QWidget</extends><header>qgsfilewidget.h</header></customwidget>
 </customwidgets>
 <resources/>
 <connections>
  <connection><sender>button_box</sender><signal>accepted()</signal><receiver>SatCompareDialogBase</receiver><slot>accept()</slot></connection>
  <connection><sender>button_box</sender><signal>rejected()</signal><receiver>SatCompareDialogBase</receiver><slot>reject()</slot></connection>
 </connections>
</ui>